POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn
DATABASE_URL=postgresql+psycopg://vpn:vpn@postgres:5432/vpn
API_HOST=0.0.0.0
API_PORT=8000
# Host bind for docker compose published API port. Keep localhost behind Caddy/firewall.
CONTROL_PLANE_BIND_IP=127.0.0.1
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_PROVIDER_TOKEN=replace_me
API_BASE_URL=http://api:8000
EDGE_SHARED_SECRET=replace_me_shared_secret
FERNET_KEY=replace_me_fernet_key
NODE_HEARTBEAT_TIMEOUT_SEC=120
DAILY_DEVICE_PRICE_KOPECKS=500

REDIS_URL=redis://redis:6379/0
INTERNAL_API_TOKEN=replace_me_internal_token
ADMIN_API_TOKEN=replace_me_admin_token
AUTO_CREATE_SCHEMA=false
ALLOW_MOCK_PAYMENTS=false
