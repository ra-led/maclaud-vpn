EDGE_HOSTNAME=edge-ru-1.local
EDGE_COUNTRY_CODE=RU
EDGE_CITY=Moscow
EDGE_MAX_CLIENTS=300
EDGE_AGENT_VERSION=0.1.0
# Public URL of this edge-agent as reachable from the central control-plane.
# Use "auto" to publish http://EDGE_PUBLIC_IP:EDGE_AGENT_PORT.
EDGE_AGENT_URL=auto

# Public or private URL of the central control-plane API as reachable from this edge server.
CONTROL_PLANE_URL=https://control.example.com
EDGE_SHARED_SECRET=replace_me_shared_secret
