AWG_PORT=51820
AWG_NET=10.77.0
AWG_EXT_IF=eth0
AWG_SERVER_CONF=/etc/amnezia/amneziawg/awg0.conf
AWG_CLIENT_CONFIG_DIR=/root/vpn-configs/amneziawg
AWG_QR_DIR=/root/vpn-configs/qrs/amneziawg
AWG_CLIENT_DNS=1.1.1.1, 8.8.8.8
AWG_ALLOWED_IPS=0.0.0.0/0, ::/0
AWG_KEEPALIVE=25
AWG_JC=7
AWG_JMIN=8
AWG_JMAX=80
AWG_S1=74
AWG_S2=123
